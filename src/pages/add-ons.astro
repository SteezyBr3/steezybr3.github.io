---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";

// To add a new product, drop the image into /public/addons and add an entry here.
const addOns = [
  { src: "/addons/flowers1.jpeg", title: "Crown", price: "£5.00" },
  { src: "/addons/flowers2.jpeg", title: "Pearl Initial", price: "£5.00" },
  { src: "/addons/flowers3.jpeg", title: "Eternal Rose", price: "£7.00" },
];
---

<Layout
  title={`Add-Ons | ${SITE.title}`}
  description="Browse optional add-ons to complement your bouquet or floral arrangement."
  canonicalURL={`${SITE.url}/add-ons`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-7xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <h1 class="text-5xl font-bold mb-4" style="color: var(--color-text);">Add-Ons</h1>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.1}>
        <div class="max-w-5xl space-y-8 mb-14" style="color: var(--color-text-soft);">
          <p class="text-lg md:text-xl leading-8">
            Add-ons are optional additions that can be added to your bouquet.
          </p>
        </div>
      </ScrollReveal>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        {addOns.map((item, index) => (
          <ScrollReveal client:idle delay={Math.min(index * 0.05, 0.3)}>
            <article class="addon-card h-full flex flex-col">
              <figure class="addon-image">
                <img src={item.src} alt={item.title} loading="lazy" />
              </figure>
              <div class="flex flex-col gap-2 p-3 sm:p-4">
                <h2 class="addon-box text-sm sm:text-base font-semibold" style="color: var(--color-text);">
                  {item.title}
                </h2>
                <p class="addon-box text-sm sm:text-base" style="color: var(--color-text-soft);">
                  {item.price}
                </p>
              </div>
            </article>
          </ScrollReveal>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .addon-card {
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid rgba(216, 202, 188, 0.9);
    background-color: var(--color-surface);
    box-shadow: 0 10px 35px rgba(90, 69, 51, 0.08);
  }

  .addon-image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .addon-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .addon-card:hover .addon-image img {
    transform: scale(1.03);
  }

  .addon-box {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-strong);
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .addon-card {
      border-radius: 1rem;
    }
  }
</style>
